# AdventureConnect runtime configuration
NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://adventureconnect:change-me@localhost:5432/adventureconnect

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=change-me

# Optional provider integrations
VIATOR_API_KEY=
TRAVELPAYOUTS_TOKEN=

# Application-level secret; generate a strong random value in real environments
APP_SECRET=change-me
